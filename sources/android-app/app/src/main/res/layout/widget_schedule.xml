<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#80000000"
    android:padding="8dp">

    <!-- 标题栏 -->
    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="课表"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- 星期表头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="10sp"
            android:gravity="center"
            android:textColor="#FFFFFF" />

        <TextView android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:id="@+id/widget_monday_header"
            android:text="一" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
        <TextView android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:id="@+id/widget_tuesday_header"
            android:text="二" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
        <TextView android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:id="@+id/widget_wednesday_header"
            android:text="三" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
        <TextView android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:id="@+id/widget_thursday_header"
            android:text="四" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
        <TextView android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:id="@+id/widget_friday_header"
            android:text="五" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
        <TextView android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:id="@+id/widget_saturday_header"
            android:text="六" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />
        <TextView android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"
            android:id="@+id/widget_sunday_header"
            android:text="日" android:textSize="10sp" android:gravity="center" android:textColor="#FFFFFF" />

    </LinearLayout>

    <!-- 课程网格（可滚动） -->
    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="6dp" />

    <!-- 底部信息栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/widget_prev_week"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="◀"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:padding="12dp" />

        <TextView
            android:id="@+id/widget_week_info"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="第1周"
            android:textSize="12sp"
            android:gravity="center"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/widget_next_week"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="▶"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:padding="12dp" />

    </LinearLayout>

</LinearLayout>
