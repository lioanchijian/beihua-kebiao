<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:orientation="horizontal"
    android:padding="0dp"
    android:layout_marginTop="0dp"
    android:layout_marginBottom="0dp">

    <!-- 节次时间 -->
    <TextView
        android:id="@+id/item_period"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:text="1"
        android:textSize="10sp"
        android:gravity="center"
        android:textColor="#FFFFFF" />

    <!-- 周一 -->
    <TextView
        android:id="@+id/item_monday"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text=""
        android:textSize="9sp"
        android:gravity="center"
        android:padding="0dp"
        android:layout_margin="0dp" />

    <!-- 周二 -->
    <TextView
        android:id="@+id/item_tuesday"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text=""
        android:textSize="9sp"
        android:gravity="center"
        android:padding="0dp"
        android:layout_margin="0dp" />

    <!-- 周三 -->
    <TextView
        android:id="@+id/item_wednesday"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text=""
        android:textSize="9sp"
        android:gravity="center"
        android:padding="0dp"
        android:layout_margin="0dp" />

    <!-- 周四 -->
    <TextView
        android:id="@+id/item_thursday"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text=""
        android:textSize="9sp"
        android:gravity="center"
        android:padding="0dp"
        android:layout_margin="0dp" />

    <!-- 周五 -->
    <TextView
        android:id="@+id/item_friday"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text=""
        android:textSize="9sp"
        android:gravity="center"
        android:padding="0dp"
        android:layout_margin="0dp" />

    <!-- 周六 -->
    <TextView
        android:id="@+id/item_saturday"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text=""
        android:textSize="9sp"
        android:gravity="center"
        android:padding="0dp"
        android:layout_margin="0dp" />

    <!-- 周日 -->
    <TextView
        android:id="@+id/item_sunday"
        android:layout_weight="1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:text=""
        android:textSize="9sp"
        android:gravity="center"
        android:padding="0dp"
        android:layout_margin="0dp" />

</LinearLayout>
